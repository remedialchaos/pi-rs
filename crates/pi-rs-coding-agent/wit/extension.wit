package pi:extension@0.1.0;

interface types {
    record header-entry {
        name: string,
        value: string,
    }

    record headers-patch {
        set: list<header-entry>,
        delete: list<string>,
    }

    record tool-call-patch {
        block: option<bool>,
        reason: option<string>,
        input-json: option<string>,
        terminate: option<bool>,
    }

    record tool-outcome {
        ok: bool,
        payload-json: string,
        error: option<string>,
    }

    record exec-result {
        exit-code: s32,
        stdout: string,
        stderr: string,
        timed-out: bool,
    }
}

interface host {
    use types.{exec-result};

    register-provider: func(name: string, config-json: string) -> result<_, string>;
    register-virtual-model: func(provider: string, id: string, definition-json: string) -> result<_, string>;
    register-mcp-server: func(name: string, config-json: string) -> result<_, string>;
    register-tool: func(name: string, description: string, schema-json: string) -> result<_, string>;
    register-command: func(name: string, description: option<string>) -> result<_, string>;
    register-shortcut: func(key: string, description: option<string>, command: string) -> result<_, string>;
    register-flag: func(name: string, description: option<string>, boolean: bool, default-value: option<string>) -> result<_, string>;
    subscribe: func(event: string) -> result<_, string>;
    ui-select: func(title: string, items: list<string>) -> option<string>;
    ui-confirm: func(title: string, message: string) -> bool;
    ui-input: func(title: string, placeholder: option<string>) -> option<string>;
    ui-editor: func(title: string, prefill: option<string>) -> option<string>;
    ui-notify: func(message: string, kind: option<string>);
    ui-set-status: func(key: string, text: option<string>);
    ui-set-widget: func(key: string, lines: option<list<string>>);
    ui-set-title: func(title: string);
    ui-set-editor-text: func(text: string);
    notify: func(level: string, message: string);
    get-flag: func(name: string) -> option<string>;
    get-cwd: func() -> string;
    get-model: func() -> option<string>;
    get-active-tools: func() -> list<string>;
    set-active-tools: func(tools: list<string>) -> result<_, string>;
    send-message: func(custom-type: string, content-json: string, trigger-turn: bool) -> result<_, string>;
    append-entry: func(custom-type: string, data-json: option<string>) -> result<string, string>;
    exec: func(command: string, args: list<string>, cwd: option<string>, timeout-ms: option<u64>) -> result<exec-result, string>;
    execute-tool: func(name: string, args-json: string) -> result<string, string>;
    send-user-message: func(content-json: string, deliver-as: option<string>) -> result<_, string>;
    set-session-name: func(name: string) -> result<_, string>;
    get-session-name: func() -> option<string>;
    set-label: func(target-id: string, label: option<string>) -> result<_, string>;
    get-all-tools: func() -> string;
    get-settings: func() -> string;
    get-commands: func() -> string;
    set-model: func(provider: string, model-id: string) -> result<_, string>;
    get-thinking-level: func() -> string;
    set-thinking-level: func(level: string) -> result<_, string>;
    unregister-provider: func(name: string) -> result<_, string>;
    unregister-mcp-server: func(name: string) -> result<_, string>;
    unregister-virtual-model: func(provider: string, id: string) -> result<_, string>;
    get-mcp-servers: func() -> string;
    events-emit: func(channel: string, data-json: string) -> result<_, string>;
    events-subscribe: func(channel: string) -> result<_, string>;
    ui-get-editor-text: func() -> string;
    ui-paste-to-editor: func(text: string);
    ui-set-working-message: func(message: option<string>);
    ui-set-widget-placed: func(key: string, lines: option<list<string>>, placement: option<string>);
    ui-select-timed: func(title: string, items: list<string>, timeout-ms: option<u64>) -> option<string>;
    ui-confirm-timed: func(title: string, message: string, timeout-ms: option<u64>) -> bool;
    ui-input-timed: func(title: string, placeholder: option<string>, timeout-ms: option<u64>) -> option<string>;
    ui-set-theme: func(name: string) -> result<_, string>;
    ui-get-theme: func() -> option<string>;
}

world extension {
    import host;
    use types.{headers-patch, tool-call-patch, tool-outcome};

    export init: func() -> result<_, string>;
    export on-tool-call: func(name: string, input-json: string) -> result<option<tool-call-patch>, string>;
    export on-before-headers: func(headers-json: string) -> result<option<headers-patch>, string>;
    export execute-tool: func(name: string, args-json: string) -> result<tool-outcome, string>;
    export run-command: func(name: string, args: string) -> result<_, string>;
}

world extension-full {
    include extension;
    export on-event: func(name: string, payload-json: string) -> result<option<string>, string>;
}
